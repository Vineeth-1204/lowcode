 application "Hospital Bed Occupancy Board"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Admission
		{
			success message = "Admission Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Single_Line
			(
    			type = text
				displayname = "Single Line"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Patient_Name
			(
    			type = text
				displayname = "Patient Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Ward
			(
				type = picklist
				maxchar = 100
				values = {"ICU","Paediatric","Maternity","general"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Expected_Discharge
			(
    			type = date
				displayname = "Expected Discharge"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Discharged","Transferred","Admitted"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Bed_No
			(
    			type = text
				displayname = "Bed Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Attending_Doctor
			(
    			type = text
				displayname = "Attending Doctor"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Actual_Discharge
			(
    			type = date
				displayname = "Actual Discharge"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Admitted_On
			(
    			type = datetime
				displayname = "Admitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Admissions
		{
			displayName = "All Admissions"
			show all rows from Admission    
			(
				Single_Line as "Single Line"
				Patient_Name as "Patient Name"
				Ward
				Expected_Discharge as "Expected Discharge"
				Status
				Bed_No as "Bed Number"
				Attending_Doctor as "Attending Doctor"
				Actual_Discharge as "Actual Discharge"
				Admitted_On as "Admitted On"
			)
		}
		kanban Ward_Board
		{
			displayName = "Ward Board"
			show all rows from Admission    
			(
				Single_Line as "Single Line"
				Patient_Name as "Patient Name"
				Ward
				Expected_Discharge as "Expected Discharge"
				Status
				Bed_No as "Bed Number"
				Attending_Doctor as "Attending Doctor"
				Actual_Discharge as "Actual Discharge"
			)
			options
			(
	 			display field = Ward
	 		)
		}
		calendar Expected_Discharge_Calendar
		{
			displayName = "Expected Discharge Calendar"
			show all rows from Admission    
			(
				Single_Line as "Single Line"
				Patient_Name as "Patient Name"
				Ward
				Expected_Discharge as "Expected Discharge"
				Status
				Bed_No as "Bed Number"
				Attending_Doctor as "Attending Doctor"
				Actual_Discharge as "Actual Discharge"
			)
			options
			(
				display field = Patient_Name
				start date = Expected_Discharge
			)
		}
		pivotchart Ward_Occupancy_Pivot
		{
			displayname = "Ward Occupancy Pivot"
			based on Autoview_1793349136120_Admission
				show all rows from Admission
				(
			Single_Line  as "Single Line"
			Patient_Name  as "Patient Name"
			Ward 
			Expected_Discharge  as "Expected Discharge"
			Status 
			Bed_No  as "Bed Number"
			Attending_Doctor  as "Attending Doctor"
				)
		}
	}
	pages
	{
		page Occupancy_Dashboard
		{
			displayname = "Occupancy Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Ward_Board'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Ward_Occupancy_Pivot'\n\t\n\t\tiszreport = 'true'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




